[{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 35,
    "width": 2000,
    "margin": "5, 0, 2, 0",
    // Choose the order of the modules
    "modules-center": [
        "hyprland/workspaces",
        "tray",
        "custom/music",
        "memory",
        "cpu",
        "temperature",
        "network",
        "pulseaudio",
        "custom/audiorec",
        "custom/updates",
        "custom/battery",
        "clock"
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "1",
            "3": "3",
            "5": "5",
            "7": "7",
            "9": "9"
            // "urgent": "",
            // "focused": "",
            // "default": ""
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 6
    },
    "clock": {
        "interval": 1,
        "locale": "C",
        "format": "{:%I:%M:%S %p  %a, %b %d}",
        "timezone": "MST"
    },
    "cpu": {
        "format": "&#8239;{usage}%",
        "tooltip": false,
        "on-click": "kitty -e 'htop'"
    },
    "memory": {
        "interval": 30,
        "format": " {used:0.2f} / {total:0.2f} GB",
        "max-length": 20,
        "tooltip": false,
        "warning": 70,
        "critical": 90
    },
    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp2_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{icon}&#8239;{temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "custom/battery": {
        "format": "{}",
        "interval": 30,
        "exec": "$HOME/.config/waybar/scripts/battery.sh",
        "return-type": "placeholder" // This is to trigger correct formatting.
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "&#8239;({signalStrength}%)",
        "format-ethernet": "&#8239;{ifname}: {ipaddr}/{cidr}",
        "format-linked": "&#8239;{ifname} (No IP)",
        "format-disconnected": "✈&#8239;Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{essid}: {ipaddr}"
    },
    "pulseaudio": {
      // "scroll-step": 1, // %, can be a float
      "format": "{icon} {volume}% {format_source}",
      "format-bluetooth": "{icon} {volume}% {format_source}",
      "format-bluetooth-muted": " {format_source}",
      "format-muted": "  {format_source}",
      "format-source": " {volume}%",
      "format-source-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
    },
    "custom/audiorec": {
        "format": "♬ Rec",
        "format-disabled": "♬ Off-air", //An empty format will hide the module.
        "return-type": "json",
        "interval": 1,
        "exec": "echo '{\"class\": \"audio recording\"}'",
        "exec-if": "pgrep ffmpeg"
    },
    "custom/music": {
        "format": " {}",
        "escape": true,
        "max-length": 40,
        "interval": 5,
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.sh",
        "exec-if": "pgrep vlc",
        "on-click": "killall vlc"
    },
    "custom/updates": {
        "format": "{} ",
        "interval": 120,
        "exec": "$HOME/.config/waybar/scripts/checkUpdates.sh"
    }
},
